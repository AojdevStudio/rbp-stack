{
  "_comment": "RBP Stack - Project-Only Isolation Mode",
  "_isolation": {
    "mode": "project-only",
    "description": "This project uses isolated settings. Global ~/.claude hooks, commands, and skills are not used.",
    "opt_in_pai": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(bun:*)",
      "Bash(ralph:*)",
      "Bash(scripts/rbp/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ]
  },
  "includeColocatedProjects": false
}
