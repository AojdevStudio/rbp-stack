{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "scripts/rbp/show-active-task.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/rbp/save-progress-to-beads.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(bun:*)",
      "Bash(scripts/rbp/*)"
    ]
  }
}
